{
  "openapi": "3.0.3",
  "info": {
    "title": "CinePulse MVP API",
    "version": "1.0.0",
    "description": "Active MVP contracts. Administrator permissions are enforced server-side. Maximum JSON request body: 64 KiB. Generated demo HLS/DASH manifests are retired."
  },
  "servers": [
    {
      "url": "/api/v1"
    }
  ],
  "components": {
    "securitySchemes": {
      "sessionCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "cp_session"
      },
      "csrfToken": {
        "type": "apiKey",
        "in": "header",
        "name": "X-CSRF-Token"
      }
    }
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Public API liveness",
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Invalid request"
          },
          "429": {
            "description": "Request limit reached"
          },
          "500": {
            "description": "Unexpected server error; correlate X-Request-ID"
          }
        }
      }
    },
    "/auth/session": {
      "get": {
        "summary": "Current account and CSRF token, or null when anonymous",
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Invalid request"
          },
          "429": {
            "description": "Request limit reached"
          },
          "500": {
            "description": "Unexpected server error; correlate X-Request-ID"
          }
        }
      }
    },
    "/auth/register": {
      "post": {
        "summary": "Register an ordinary account and issue a cookie session",
        "responses": {
          "201": {
            "description": "Success"
          },
          "400": {
            "description": "Invalid request"
          },
          "429": {
            "description": "Request limit reached"
          },
          "500": {
            "description": "Unexpected server error; correlate X-Request-ID"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": {
                    "type": "string",
                    "format": "email",
                    "maxLength": 254
                  },
                  "password": {
                    "type": "string",
                    "minLength": 12,
                    "maxLength": 128
                  },
                  "display_name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 80
                  }
                },
                "required": [
                  "email",
                  "password"
                ],
                "additionalProperties": false
              }
            }
          }
        }
      }
    },
    "/auth/login": {
      "post": {
        "summary": "Verify credentials and issue a cookie session",
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Invalid request"
          },
          "429": {
            "description": "Request limit reached"
          },
          "500": {
            "description": "Unexpected server error; correlate X-Request-ID"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": {
                    "type": "string",
                    "format": "email",
                    "maxLength": 254
                  },
                  "password": {
                    "type": "string",
                    "minLength": 12,
                    "maxLength": 128
                  },
                  "display_name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 80
                  }
                },
                "required": [
                  "email",
                  "password"
                ],
                "additionalProperties": false
              }
            }
          }
        }
      }
    },
    "/auth/logout": {
      "post": {
        "summary": "Revoke the current session",
        "security": [
          {
            "sessionCookie": [],
            "csrfToken": []
          }
        ],
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Invalid request"
          },
          "401": {
            "description": "Sign in required"
          },
          "403": {
            "description": "Invalid request token or insufficient permission"
          },
          "429": {
            "description": "Request limit reached"
          },
          "500": {
            "description": "Unexpected server error; correlate X-Request-ID"
          }
        }
      }
    },
    "/auth/password": {
      "post": {
        "summary": "Change password, revoke all previous sessions, issue a new session",
