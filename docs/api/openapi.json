    "/playback/session": {
      "post": {
        "summary": "Issue a resource-bound playback token only when a source exists",
        "responses": {
          "201": {
            "description": "Configured source URLs and signed resource-bound token; no DRM or quality entitlement claim"
          },
          "400": {
            "description": "Invalid request"
          },
          "409": {
            "description": "SOURCE_UNAVAILABLE"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "content_type": {
                    "type": "string",
                    "enum": [
                      "movie",
                      "series"
                    ]
                  },
                  "content_id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 150
                  },
                  "episode_id": {
                    "type": "string",
                    "nullable": true
                  },
                  "country_code": {
                    "type": "string",
                    "pattern": "^[A-Z]{2}$"
                  }
                },
                "required": [
                  "content_type",
                  "content_id"
                ],
                "additionalProperties": false
              }
            }
          }
        }
      }
    },
