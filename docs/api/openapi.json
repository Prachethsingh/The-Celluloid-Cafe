      "put": {
        "summary": "Upsert an owned item; body id must match path id; maximum 16 KiB JSON",
        "security": [
          {
            "sessionCookie": [],
            "csrfToken": []
          }
        ],
        "responses": {
          "200": {
            "description": "Success"
