# Active Node 24 MVP configuration. npm run dev reads .env if present.
NODE_ENV=development
PORT=8000
ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
DATABASE_PATH=data/platform.sqlite
MEDIA_DIRECTORY=data/media

# Required in production: generate a private random value of at least 32 chars.
PLAYBACK_SIGNING_KEY=

# Optional one-time administrator provisioning; no default account is created.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Optional proposed Compose services; the MVP currently uses SQLite.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=movie_platform
POSTGRES_PORT=5432
REDIS_PORT=6379
# Optional public deployment metadata and automatic HTTPS certificate settings.
# Use the real hostname, without a scheme, slash or port.
SITE_DOMAIN=
ACME_EMAIL=
# For direct frontend builds; HTTPS compose supplies this from SITE_DOMAIN.
VITE_SITE_URL=http://127.0.0.1:5173/
