          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "title": {
                    "type": "string"
                  },
                  "type": {
                    "type": "string",
                    "enum": [
                      "movie",
                      "series"
                    ]
                  },
                  "progress_seconds": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1000000
                  },
                  "duration_seconds": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1000000
                  }
                },
                "required": [
                  "id",
                  "title",
                  "type"
                ],
                "additionalProperties": true
              }
            }
          }
        }
      },
      "delete": {
        "summary": "Remove an owned library item",
        "security": [
          {
            "sessionCookie": [],
            "csrfToken": []
          }
        ],
